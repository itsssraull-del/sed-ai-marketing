# ══════════════════════════════════════════════════════════════════════════
# SED Energy AI Marketing System — Environment Variables
# Copy to .env and fill in all values before running
# ══════════════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-super-secret-key-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,https://app.sed.energy

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sed_user:password@localhost:5432/sed_marketing
POSTGRES_PASSWORD=strong-postgres-password
REDIS_URL=redis://:redis-password@localhost:6379/0
REDIS_PASSWORD=strong-redis-password

# ─── AI APIs ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=                        # Optional fallback

# ─── Vector Database (Pinecone) ───────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_ENV=us-east-1-aws
PINECONE_INDEX_NAME=sed-energy-knowledge

# ─── Meta / Facebook + Instagram ──────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=EAAxxxxx...           # Long-lived Page Access Token
META_PAGE_ID=your-facebook-page-id
META_INSTAGRAM_ACCOUNT_ID=your-ig-business-account-id
META_GRAPH_API_VERSION=v19.0

# ─── LinkedIn ─────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=AQVxxxx...       # OAuth 2.0 access token
LINKEDIN_ORGANIZATION_ID=your-org-id  # From company page URL

# ─── WhatsApp Business API ────────────────────────────────────────────────
WHATSAPP_API_TOKEN=EAAxxxxx...
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# ─── Image Generation ─────────────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_...             # For Flux SDXL
STABILITY_API_KEY=sk-...               # Optional: Stability AI
IDEOGRAM_API_KEY=                      # Optional: Ideogram

# ─── Video Generation ─────────────────────────────────────────────────────
RUNWAY_API_KEY=                        # Runway ML (Gen-3)
PIKA_API_KEY=                          # Optional: Pika Labs
KLING_API_KEY=                         # Optional: Kling AI

# ─── Object Storage (MinIO or S3) ─────────────────────────────────────────
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=sed-energy-assets
S3_REGION=af-south-1                  # ap-south-1 or your preferred region
S3_ENDPOINT_URL=                      # Leave blank for AWS S3, set for MinIO

# ─── Sage ERP ─────────────────────────────────────────────────────────────
SAGE_API_URL=                         # e.g. https://api.sage.com/v1
SAGE_API_KEY=
SAGE_COMPANY_ID=

# ─── News & Industry ──────────────────────────────────────────────────────
NEWS_API_KEY=                          # NewsAPI.org key
NEWSDATA_API_KEY=                      # Optional: NewsData.io

# ─── Notifications ────────────────────────────────────────────────────────
SENDGRID_API_KEY=
NOTIFICATION_EMAIL=admin@sed.energy
SLACK_WEBHOOK_URL=                    # Optional: Slack alerts

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Celery Flower ────────────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=strong-flower-password
