# ── Required ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Railway provides these automatically when you add PostgreSQL + Redis plugins:
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://default:password@host:6379

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
REPLICATE_API_TOKEN=r8_...
PINECONE_API_KEY=...

# S3 storage (optional — can use Railway volume or leave blank)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=sed-energy-assets

# Social (optional — add when connecting platforms)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# CORS — add your Vercel URL here if different
# ALLOWED_ORIGINS=["http://localhost:3000","https://sed-ai-marketing.vercel.app"]
